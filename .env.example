# ---> Central brand + product configuration. Change the name here to rebrand. <---
# Public site URL used for SEO / sitemap / OpenGraph. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://freearn.online

# Supabase (optional for now — auth/database ready, app runs in mock mode without it)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Mock provider: NEVER enable mock rewards in production.
# Allowed values: "true" | "false". Defaults to true in development, false in production.
MOCK_PROVIDER_ENABLED=true

# Future BitLabs integration (server-only — never prefix with NEXT_PUBLIC_)
BITLABS_APP_TOKEN=
BITLABS_SECRET=
BITLABS_CALLBACK_ENABLED=false

# CPX Research integration (server-only — never prefix with NEXT_PUBLIC_)
# App ID is public (appears in the SurveyWall URL). Secrets must stay server-side.
CPX_APP_ID=
CPX_APP_SECURE_HASH=
# Optional dedicated postback secret; when empty, CPX_APP_SECURE_HASH is used.
CPX_POSTBACK_SECRET=
# Master switch: postbacks are rejected unless this is exactly "true".
CPX_POSTBACK_ENABLED=false

# AdGem Server Postback v3 (server-only — never prefix with NEXT_PUBLIC_)
# Postback Key from the AdGem publisher dashboard (shown once — store securely).
ADGEM_POSTBACK_KEY=
# Master switch: postbacks are rejected unless this is exactly "true".
ADGEM_POSTBACK_ENABLED=false
# Optional AdGem App/Property ID override for the offerwall (public, non-secret).
# When empty, the documented dashboard value 33683 is used — no setup required.
ADGEM_APP_ID=

# TimeWall postback (server-only — never prefix with NEXT_PUBLIC_)
# SecretKey from the TimeWall publisher dashboard. Used byte-exactly as-is.
TIMEWALL_POSTBACK_SECRET=
# Master switch: postbacks are rejected unless this is exactly "true".
TIMEWALL_POSTBACK_ENABLED=false
# Official TimeWall Placement URL (public, non-secret). Empty until the
# placement is approved — the Earn UI hides TimeWall while this is unset.
# Example shape (DO NOT GUESS — paste the exact URL TimeWall issues):
# TIMEWALL_WALL_URL=https://wall.timewall.io/...
TIMEWALL_WALL_URL=
# Credit allowlist for TimeWall postback `type` values (comma-separated,
# normalized like callback types). Production value: `credit`.
# Unset/empty = fail closed (every verified event is held, nothing credits).
#TIMEWALL_CREDITABLE_TYPES=

# TheoremReach — default OFF (server-only — never prefix with NEXT_PUBLIC_)
# API key from the TheoremReach publisher dashboard. Travels inside the
# server-built entry URL (public-in-URL like CPX_APP_ID) but is sourced
# server-side only — never expose it to browser code directly.
THEOREMREACH_API_KEY=
# Secret Key from the TheoremReach publisher dashboard. Used for the
# entry-link HMAC-SHA1. NEVER log it, never return it, never put it in URLs.
THEOREMREACH_SECRET_KEY=
# Master switch: postbacks are rejected unless this is exactly "true".
THEOREMREACH_POSTBACK_ENABLED=false
# Placement / partner ID from the TheoremReach publisher dashboard (public
# routing value, used as partner_id in the entry URL).
THEOREMREACH_PLACEMENT_ID=
# Public Earn launcher. Requires reward processing to be explicitly enabled too.
THEOREMREACH_WALL_ENABLED=false
# Pilot-only wall and callback allowlist. Keep both disabled/empty by default.
THEOREMREACH_PILOT_ENABLED=false
THEOREMREACH_PILOT_USER_IDS=
# Debug pilot only: wall URL includes debug=true and all reward processing is blocked.
THEOREMREACH_PILOT_DEBUG_ENABLED=false

# Admin allowlist (comma-separated emails). Admin routes deny by default.
ADMIN_EMAILS=

# Waitlist / contact (Resend, Supabase table, or any provider — see README)
WAITLIST_PROVIDER=log

# TheoremReach money-write and Event Webhook gates. Keep all OFF until the
# provider samples and activation checklist are approved.
THEOREMREACH_REWARD_PROCESSING_ENABLED=false
THEOREMREACH_EVENT_WEBHOOK_ENABLED=false
THEOREMREACH_EVENT_PROCESSING_ENABLED=false

# Offerwall.GG — preview can be enabled separately; financial gates default OFF.
OFFERWALLGG_PUBLIC_KEY=
OFFERWALLGG_SECRET_KEY=
OFFERWALLGG_PREVIEW_ENABLED=false
OFFERWALLGG_TEST_POSTBACK_ENABLED=false
OFFERWALLGG_LINK_EXPIRY_ENABLED=false

# Financial Offerwall.GG integration (keep all FALSE until reviewed)
OFFERWALLGG_POSTBACK_ENABLED=false
OFFERWALLGG_REWARD_PROCESSING_ENABLED=false

# AdMantum (server-only; all financial gates default OFF)
ADMANTUM_PUBLISHER_ID=451398
ADMANTUM_APP_ID=
ADMANTUM_SECRET_KEY=
ADMANTUM_CALLBACK_TOKEN=
ADMANTUM_ENABLED=false
ADMANTUM_POSTBACK_ENABLED=false
ADMANTUM_REWARD_PROCESSING_ENABLED=false
OFFERWALLGG_WALL_ENABLED=false
